# Copy to .env or export in your shell. All optional.
# Defaults are shown; uncomment and edit what you need.

# Where blockers are logged (one JSON object per line)
# TASKPRIORITIZER_BLOCKERS=$HOME/.local/share/task-prioritizer/blockers.jsonl

# Where auto-resolve attempts are recorded
# TASKPRIORITIZER_RESOLUTIONS=$HOME/.local/share/task-prioritizer/resolutions.jsonl

# Completed-work metrics for the leaderboard (one JSON object per line)
# TASKPRIORITIZER_METRICS=$HOME/.local/share/task-prioritizer/metrics.jsonl

# Optional platform probe cache: {"platform": {"verdict": "GO"|"BLOCKED"}}
# TASKPRIORITIZER_CACHE=$HOME/.local/share/task-prioritizer/platform-cache.json

# Optional resolvers config (see examples/resolvers.json)
# TASKPRIORITIZER_RESOLVERS=./resolvers.json
